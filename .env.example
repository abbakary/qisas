# Frontend. Leave empty in local `npm run dev` (Vite proxy).
# Production / Vercel builds default to Railway if this is empty.
VITE_API_URL=https://qisass-production.up.railway.app

# Backend AI keys (set these in backend/.env)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Production scale (backend/.env):
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/qisas
# MEDIA_CDN_BASE=https://cdn.example.com
